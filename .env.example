# Öffentliche Basis-URL (für Canonicals, Sitemap, strukturierte Daten)
NEXT_PUBLIC_SITE_URL=https://baer-seibl-gmbh.de

# Übergabe von Anfragen/Bewerbungen/Terminen an CRM oder Büroprozess (JSON bzw. multipart POST).
# Ohne diesen Wert meldet die Website in Produktion eine Störung und zeigt Telefon/E-Mail als Ausweichweg.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Zugriffsschutz der persönlichen ELVIANE-QR-Seite: ein Token je Audit-ID (Bindestrich -> Unterstrich).
# QR-Ziel: /a/BS-2611?k=<Token>
AUDIT_TOKEN_BS_2611=

# ELVIANE-Kontakt für Anruf-Icon und fixierte Leiste auf der QR-Seite
ELVIANE_TEL=
